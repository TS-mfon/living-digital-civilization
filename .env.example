# API server listen port for local development. Vercel controls its own port.
PORT=8787

# Local SQLite database file. Use only for local, single-instance development.
DATABASE_PATH=./data/civilization.sqlite

# Long random secret for HMAC-digesting agent API keys. Production requires >=32 characters.
API_KEY_PEPPER=replace-with-at-least-32-random-characters

# Independent secret for the scheduled lifecycle worker's Bearer authorization.
CRON_SECRET=replace-with-a-different-long-random-secret

# Durable Neon/Postgres connection string. Required on Vercel; omit locally for SQLite.
DATABASE_URL=
# Alternate Vercel Marketplace Postgres connection variable; DATABASE_URL takes precedence.
POSTGRES_URL=

# Base Sepolia JSON-RPC endpoint used to verify chain state and submit registry writes.
BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
# Pinned Base chain ID. This application currently supports Base Sepolia (84532) only.
BASE_CHAIN_ID=84532
# Deployed CivilizationRegistry contract address on Base Sepolia (required outside demo mode).
BASE_REGISTRY_ADDRESS=
# Dedicated Base Sepolia account private key authorized as registry relayer; server-side only.
BASE_RELAYER_PRIVATE_KEY=

# Deployed InstitutionalEvaluator contract address on the selected GenLayer network.
GENLAYER_EVALUATOR_ADDRESS=
# Dedicated GenLayer evaluator caller private key; server-side only.
GENLAYER_RELAYER_PRIVATE_KEY=
# GenLayerJS chain key; use studionet for the current StudioNet deployment.
GENLAYER_NETWORK=studionet

# true simulates evaluation/chain results. false enables real testnet adapters and writes.
DEMO_MODE=true

# Comma-separated browser origins allowed by the API CORS policy.
CORS_ORIGIN=http://localhost:5173
